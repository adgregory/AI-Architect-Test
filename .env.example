# Copy to .env (git-ignored). Read by docker compose (variable substitution) and by the app's Settings.

# --- Agent service: Gemini on Vertex AI via Application Default Credentials (optional) ----
# Without this block the stack still runs: /api/ask answers with the retrieved sentence closest to the question.
# Run once on the host: gcloud auth application-default login
# COMPOSE_FILE=docker-compose.yml:docker-compose.gcp.yml   # mounts the credentials read-only into the agent
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash      # gemini-3.5-flash-lite: faster/cheaper
# GCLOUD_ADC=~/.config/gcloud/application_default_credentials.json
# LLM_PROVIDER=auto              # auto | gemini | none; 'bedrock' on AgentCore in AWS

# --- Stack selection and host ports (defaults avoid common clashes) -----------------------
# STACK=chosen                   # chosen | fallback
# CPU_WORKERS=1
# API_PORT=8000
# AGENT_PORT=18080
# POSTGRES_PORT=55432
# TEMPORAL_UI_PORT=8233

# --- Optional: in-process answering instead of the agent (host runs only; compose doesn't pass these)
# ANSWER_BACKEND=inline
# OPENAI_API_KEY=
