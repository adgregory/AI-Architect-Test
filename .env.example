# Copy to .env (git-ignored). Read by docker compose (variable substitution) and by the app's Settings.

# --- Agent service: Gemini on Vertex AI via Application Default Credentials --------------
# Run once on the host: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash      # gemini-3.5-flash-lite: faster/cheaper
# GCLOUD_ADC=~/.config/gcloud/application_default_credentials.json   # mounted read-only into the agent
# LLM_PROVIDER=gemini            # 'bedrock' on AgentCore in AWS

# --- Stack selection and host ports (defaults avoid common clashes) -----------------------
# STACK=chosen                   # chosen | fallback
# CPU_WORKERS=1
# API_PORT=8000
# AGENT_PORT=18080
# POSTGRES_PORT=55432
# TEMPORAL_UI_PORT=8233

# --- Optional: in-process answering instead of the agent ---------------------------------
# ANSWER_BACKEND=inline
# OPENAI_API_KEY=
