# syntax=docker/dockerfile:1.7
#
# Agent service: Strands agent on the AgentCore Runtime contract
# (POST /invocations, GET /ping, port 8080). The same image runs locally in docker compose
# (Gemini on Vertex via ADC, mounted read-only at runtime) and on AgentCore Runtime in AWS
# (Bedrock, via the runtime's IAM role). No OCR/NER models, no torch.
#
#   docker build -f Dockerfile.agent -t pdf-name-extractor-agent .
#   (AgentCore Runtime requires linux/arm64: add --platform linux/arm64 when building on x86)

ARG PYTHON_VERSION=3.12

# --------------------------------------------------------------------------- #
FROM python:${PYTHON_VERSION}-slim AS deps
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra agent

# --------------------------------------------------------------------------- #
FROM deps AS models
ENV MODELS_DIR=/app/.models \
    LOG_JSON=true \
    EMBEDDING_ENGINE=fastembed
COPY app ./app
COPY scripts/prepare_models.py ./scripts/
# Bake the query-embedding model (bge-small via fastembed) so the agent starts offline.
RUN /app/.venv/bin/python scripts/prepare_models.py --components embeddings

# --------------------------------------------------------------------------- #
FROM python:${PYTHON_VERSION}-slim AS runtime
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODELS_DIR=/app/.models \
    HF_HUB_OFFLINE=1 \
    LOG_JSON=true \
    EMBEDDING_ENGINE=fastembed
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY --from=deps /app/.venv /app/.venv
COPY --from=models --chown=app:app /app/.models /app/.models
COPY app ./app
USER app
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(urllib.request.urlopen('http://127.0.0.1:8080/ping', timeout=2).status != 200)"
CMD ["python", "-m", "app.agent.server"]
